# Copy this file to .env and fill in real values.
# Nothing here is a secret — this file is safe to commit; .env itself is gitignored.

# --- Database ---
# Local Postgres: postgresql://vision:vision@localhost:5432/vision
# Neon (or any remote managed Postgres): use the connection string from your
# Neon dashboard. SSL is applied automatically for any non-localhost host —
# see src/config/database.ts — so you don't need to add ?sslmode=require
# yourself (it's harmless if you do, just redundant).
DATABASE_URL=postgresql://vision:vision@localhost:5432/vision

PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Runs the server against simulated hardware instead of a real robot.
# Set to false only once real ESP32-CAM firmware is flashed and reachable.
# ---- How the brain + Vision Script compiler reach the robot ----
#   simulation : no ESP32 needed — commands drive a virtual robot inside the server
#   hardware   : commands go to the real ESP32 over the persistent WebSocket link
# Optional: the mode is chosen on the dashboard's Robot page; this is only the starting mode (default simulation).
# ROBOT_MODE=simulation
# Simulation only: folder of .jpg/.png images the virtual camera cycles through
# (e.g. photos of a person) so the brain has something to look at. Empty = no frames.
SIM_FRAMES_DIR=

# --- AI fallback (OpenRouter) — optional, last resort in the memory chain ---
OPENROUTER_API_KEY=
# Several keys per provider are supported (GEMINI_API_KEYS=k1,k2,... or GEMINI_API_KEY_2=...): an exhausted key hands over to the next.
# See the root .env.example for the details.
OPENROUTER_MODEL=openrouter/auto
# A vision-capable/multimodal model, for real object/person recognition via
# AI. Leave unset to use local heuristic detection only.
OPENROUTER_VISION_MODEL=

# --- Text-to-speech ---
# "edge" is free, no API key needed (see docs/audio.md) — good default.
TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-GB-RyanNeural

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Only used if TTS_PROVIDER=omnivoice.
WAVESPEED_API_KEY=
OMNIVOICE_VOICE_DESCRIPTION=

# --- Speech-to-text ---
# "mock" always returns an empty transcript — fine for non-voice development.
STT_PROVIDER=mock
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Google Drive (media storage) — optional ---
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# --- Auth secrets ---
# REQUIRED in production (server refuses to boot without them there).
# Optional in development — an insecure placeholder is used automatically
# if left blank, so local dev works without generating these.
# Generate real values with: openssl rand -hex 32
JWT_SECRET=
ROBOT_AUTH_SECRET=

# --- Session cookie ---
# lax (default): dashboard and API are the same site / localhost.
# none: dashboard and API on DIFFERENT sites (e.g. Vercel + Render). Needs HTTPS.
COOKIE_SAMESITE=lax

# --- Email (password reset) ---
# Any SMTP provider. If SMTP_HOST is empty: dev logs the reset link to the
# console; production logs an error and sends nothing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Vision <no-reply@example.com>

# Only needed if the dashboard's websocket connects to a different origin
# than FRONTEND_URL.
SOCKET_URL=
