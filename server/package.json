{
  "name": "vision-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/database/seed/seed.ts",
    "setup:face-models": "node scripts/download-face-models.js",
    "test": "vitest run",
    "setup:native": "bash scripts/setup-native-deps.sh",
    "build:sim-autonomous": "tsc -p simulation/autonomous",
    "build:sim": "npm run build:sim-autonomous"
  },
  "dependencies": {
    "@tensorflow/tfjs-node": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "@vladmandic/human": "^3.3.6",
    "bcryptjs": "^2.4.3",
    "canvas": "^2.11.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "msedge-tts": "^2.0.7",
    "nodemailer": "^10.0.14",
    "onnxruntime-node": "^1.29.0",
    "pg": "^8.13.0",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.0",
    "ws": "^8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.24.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
