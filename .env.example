DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# Optional — a vision-capable (multimodal) model, e.g. a model on OpenRouter
# that accepts image inputs. Only used for the recognition stage of the
# vision pipeline, and only ever called on frames that already passed local
# pre-attentive filtering (see docs/vision-pipeline.md). Leave unset to run
# on local heuristic detection only.
OPENROUTER_VISION_MODEL=

# Extra AI providers for the silent multi-model fallback (all optional). If the first model is out of
# quota, rate limited or down, the next configured one answers; order lives in server/ai-routing.json.
# Providers without a key are skipped. Free keys: https://aistudio.google.com/ (Gemini).
GEMINI_API_KEY=
# MORE THAN ONE KEY (for example one per admin): when a key runs out of quota or is rate limited, the next key
# answers automatically, before any other provider. Use any of these (they can be mixed; duplicates are ignored):
#   GEMINI_API_KEYS=key1,key2,key3,key4,key5,key6      (comma, semicolon or new line separated)
#   GEMINI_API_KEY_2=key2   ...   GEMINI_API_KEY_20=key20
# The same works for OPENROUTER_, OPENAI_, XAI_, ANTHROPIC_ and LLM_ keys.
# GEMINI_API_KEYS=
# GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
# Any other OpenAI-compatible server (Ollama, LM Studio, Groq, ...):
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=

# Pi's voice (text-to-speech).
# TTS_PROVIDER=edge is FREE — no API key, no signup (uses Microsoft Edge's
# neural voices). Browse voice names at https://github.com/Migushthe2nd/MsEdgeTTS#voices
# Edge's own output is MP3, which the robot has no on-device decoder for —
# so it's transcoded to raw PCM server-side (using the bundled ffmpeg
# binary, see server/src/audio/audioTranscode.ts) before being sent to the
# robot's speaker. Requires ffmpeg-static to have resolved a binary for
# your platform at install time (it's a normal npm dependency, no separate
# install step) — if it somehow can't, speech still previews fine on the
# dashboard, it just won't reach the physical speaker that one time.
# Set TTS_PROVIDER=mock to run silent, or elevenlabs/omnivoice below.
TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-GB-RyanNeural

# Optional paid alternative — sends raw PCM natively (no transcode step
# needed). Only used if TTS_PROVIDER=elevenlabs. Also doubles as the
# ElevenLabs speech-to-text ("Scribe") key if STT_PROVIDER=elevenlabs below
# — one key covers both directions of the conversation.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Optional alternative — OmniVoice (k2-fsa/OmniVoice), a massively
# multilingual (600+ languages) zero-shot TTS model, served via
# WaveSpeedAI. Distinguishing feature is attribute-driven voice design
# instead of a fixed named voice — see OMNIVOICE_VOICE_DESCRIPTION below
# and docs/audio.md for the full valid-attribute list (gender, age, pitch,
# accent). Only used if TTS_PROVIDER=omnivoice.
WAVESPEED_API_KEY=
OMNIVOICE_VOICE_DESCRIPTION=

# Pi's hearing (speech-to-text). Unlike TTS, there's no free no-signup
# option, so this defaults to STT_PROVIDER=mock (always returns an empty
# transcript — conversation features like asking someone's name or
# interpreting a search bystander's reply need a real provider to
# function). Set STT_PROVIDER=elevenlabs to reuse ELEVENLABS_API_KEY above,
# or STT_PROVIDER=groq for a separate, very fast Whisper-compatible API
# (free tier available at console.groq.com).
STT_PROVIDER=mock
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

JWT_SECRET=change-me
ROBOT_AUTH_SECRET=change-me

SOCKET_URL=http://localhost:4000

# Optional. The robot mode (virtual robot or real ESP32) is chosen on the dashboard's Robot page and remembered by the server.
# This value is only the starting mode when nothing has been chosen yet. Leave it out to start in simulation.
# ROBOT_MODE=simulation
